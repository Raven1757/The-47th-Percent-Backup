            };
            e.endingSlides = buildSlides(entry, quickstats, out);
            e._endingAudioPlayedKey = (typeof window !== "undefined" && window.__tctLastEndingAudioKey) || "";

            const html = constructSlide(1);
            syncEndingSlideDomDeferred();
            return html;
        }
    }

    return "";
};

