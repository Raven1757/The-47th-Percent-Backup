    link.click();

    exportStage.remove();
    window._isExporting = false;
    currentMode = origMode;
    const sel = document.getElementById('visualization_mode');
    if (sel) sel.value = origMode;

    updateControls();
    updateMapStyles();
    updateLegend();
  }

