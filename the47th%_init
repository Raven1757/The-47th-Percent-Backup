// build a county adjacency list keyed by FIPS with bounded nearest neighbor search
const _spatialAdjacencyCache = new Map();

function buildCountyAdjacency(geoFips, neighborData, centroidByFips, fipsList, k = 6) {
  const cacheKey = `${fipsList.length}_${k}_${fipsList[0] || ''}_${fipsList[fipsList.length - 1] || ''}`;
  if (_spatialAdjacencyCache.has(cacheKey)) {
    return _spatialAdjacencyCache.get(cacheKey);
  }

  const indexByFips = {};
  fipsList.forEach((f, i) => { indexByFips[f] = i; });

  const adjacency = fipsList.map(() => new Set());

  // topological (shared-border) neighbours
  fipsList.forEach((fips, i) => {
    const gi = indexByFips[fips];
    const neigh = neighborData[gi] || [];
    neigh.forEach(nIdx => {
      const nFips = geoFips[nIdx];
      if (nFips !== undefined && nFips !== fips && indexByFips[nFips] !== undefined) {
        adjacency[i].add(indexByFips[nFips]);
      }
    });
  });

  // kNN by centroid distance - guarantees connectivity and fills in the
  // near neighbours that topology misses (islands, split counties, bays)
  const withCentroids = [];
  fipsList.forEach((fips, i) => {
    const c = centroidByFips[fips];
    if (c) withCentroids.push({ i, c });
  });

  withCentroids.forEach(({ i, c }) => {
    const best = [];
    for (let idx = 0; idx < withCentroids.length; idx++) {
      const j = withCentroids[idx].i;
      if (i === j) continue;
      const cj = withCentroids[idx].c;
      const dx = c[0] - cj[0], dy = c[1] - cj[1];
      const d = dx * dx + dy * dy;
      if (best.length < k) {
        best.push([j, d]);
        best.sort((a, b) => a[1] - b[1]);
      } else if (d < best[k - 1][1]) {
        best[k - 1] = [j, d];
        best.sort((a, b) => a[1] - b[1]);
      }
    }
    for (let t = 0; t < best.length; t++) {
      adjacency[i].add(best[t][0]);
    }
  });

  // symmetrise: an edge is an edge in both directions
  for (let i = 0; i < adjacency.length; i++) {
    adjacency[i].forEach(j => adjacency[j].add(i));
  }

  // expose the graph keyed by FIPS with FIPS-valued neighbour lists
  const byFips = {};
  fipsList.forEach((fips, i) => {
    byFips[fips] = Array.from(adjacency[i]).map(j => fipsList[j]);
  });
  _spatialAdjacencyCache.set(cacheKey, byFips);
  return byFips;
}

// spatial diffusion
function diffuseNoise(values, adjacency, iterations = 3, alpha = 0.62) {
  let cur = values.slice();
  const next = new Array(cur.length);
  for (let it = 0; it < iterations; it++) {
    for (let i = 0; i < cur.length; i++) {
      const neigh = adjacency[i];
      if (!neigh || neigh.length === 0) { next[i] = cur[i]; continue; }
      let acc = 0;
      for (let t = 0; t < neigh.length; t++) acc += cur[neigh[t]];
      const mean = acc / neigh.length;
      next[i] = (1 - alpha) * cur[i] + alpha * mean;
    }
    for (let i = 0; i < cur.length; i++) cur[i] = next[i];
  }
  const mean = cur.reduce((a, b) => a + b, 0) / (cur.length || 1);
  return cur.map(v => v - mean);
}

// Moran eigenvector (leading spatial eigenvector)
function leadingSpatialEigenvector(adjacency, count) {
  if (count < 3) return new Array(count).fill(0);

  const W = [];
  for (let i = 0; i < count; i++) {
    const neigh = adjacency[i];
    const row = new Array(count).fill(0);
    if (neigh && neigh.length) {
      const share = 1 / neigh.length;
      for (let t = 0; t < neigh.length; t++) row[neigh[t]] += share;
    }
    W.push(row);
  }

  let v = new Array(count).fill(0);
  for (let i = 0; i < count; i++) {
    v[i] = Math.sin((i + 1) * 12.9898) * 43758.5453;
  }

  const y = new Array(count).fill(0);
  let lambda = 0;

  for (let iter = 0; iter < 220; iter++) {
    for (let i = 0; i < count; i++) {
      let acc = 0;
      const row = W[i];
      for (let j = 0; j < count; j++) acc += row[j] * v[j];
      y[i] = acc;
    }
    let mean = 0;
    for (let i = 0; i < count; i++) mean += y[i];
    mean /= count;
    for (let i = 0; i < count; i++) y[i] -= mean;

    let norm = 0;
    for (let i = 0; i < count; i++) norm += y[i] * y[i];
    norm = Math.sqrt(norm);
    if (norm < 1e-12) return new Array(count).fill(0);

    for (let i = 0; i < count; i++) v[i] = y[i] / norm;

    if (iter > 0 && Math.abs(norm - lambda) < 1e-10) break;
    lambda = norm;
  }

  const score = v.reduce((acc, val, i) => acc + val * (adjacency[i] ? adjacency[i].length : 0), 0);
  if (score < 0) v = v.map(x => -x);

  return v;
}

function standardise(arr) {
  const n = arr.length;
  if (!n) return [];
  let mean = 0;
  for (let i = 0; i < n; i++) mean += arr[i];
  mean /= n;
  let varsum = 0;
  for (let i = 0; i < n; i++) varsum += (arr[i] - mean) * (arr[i] - mean);
  const sd = Math.sqrt(varsum / n);
  if (sd < 1e-12) return new Array(n).fill(0);
  return arr.map(x => (x - mean) / sd);
}

