    function updatePrecinctColors() {
      if (!_activeMlMap || !_activeMlMapReady || isUserInteracting || currentMode !== "precinct") return;

      const loadedPmTilesYear = PMTILES_URLS[CURRENT_YEAR] ? CURRENT_YEAR : "2008";
      let hasActiveShuffle = (loadedPmTilesYear !== CURRENT_YEAR) || (tpCandidatesInGame && tpCandidatesInGame.length > 0);
      if (!hasActiveShuffle) {
        for (let fips in _fipsMultipliers) {
          const mult = _fipsMultipliers[fips];
          if (Math.abs(mult.mD - 1) > 0.001 || Math.abs(mult.mR - 1) > 0.001 || Math.abs(mult.mO - 1) > 0.001) {
            hasActiveShuffle = true;
            break;
          }
        }
      }

      if (!hasActiveShuffle) {
        try {
          _activeMlMap.removeFeatureState({ source: "blockgroups", sourceLayer: "blockgroups" });
        } catch (e) { }
        _activeMlMap.setPaintProperty("precinct-fill", "fill-color", getPrecinctGPUColorExpression());
        precColorCache = {};
        return;
      }

      if (precViewDirty || !precVisCache) {
        let raw;
        try {
          raw = _activeMlMap.queryRenderedFeatures({ layers: ["precinct-fill"] });
        } catch (e) {
          return;
        }
        if (!raw || raw.length === 0) return;
        const seenB = new Set();
        const nextVis = [];
        for (let ri = 0; ri < raw.length; ri++) {
          const rf = raw[ri];
          const rg = normalizeGeoid(rf.id || (rf.properties && rf.properties.GEOID));
          if (!rg || seenB.has(rg)) continue;
          seenB.add(rg);
          const rp = rf.properties || {};
          nextVis.push({
            geoid: rg,
            cf: rg.slice(0, 5),
            vt: Number(rp.votes_total) || 0,
            vd: Number(rp.votes_dem) || 0,
            vr: Number(rp.votes_rep) || 0
          });
        }

        const pruned = {};
        for (let ci = 0; ci < nextVis.length; ci++) {
          const g = nextVis[ci].geoid;
          const prev = precColorCache[g];
          if (prev !== undefined) pruned[g] = prev;
        }
        precColorCache = pruned;

        precVisCache = nextVis;
        precViewDirty = false;
      }

      if (precVisCache.length === 0) return;

      _activeMlMap.setPaintProperty("precinct-fill", "fill-color", PRECINCT_SHUFFLED_FILL_EXPR);

      requestAnimationFrame(() => {
        if (currentMode !== "precinct") return;
        const len = precVisCache.length;
        const numTp = (tpCandidatesInGame && tpCandidatesInGame.length > 0) ? tpCandidatesInGame.length : 0;

        const scratch = numTp > 0 ? [{ id: demCandId, votes: 0 }, { id: repCandId, votes: 0 }] : null;
        if (numTp > 0) {
          for (let ti = 0; ti < numTp; ti++) scratch.push({ id: tpCandidatesInGame[ti], votes: 0 });
        }

        for (let fi = 0; fi < len; fi++) {
          const f = precVisCache[fi];
          const geoid = f.geoid;
          const countyFips = f.cf;

          const mults = _fipsMultipliers[countyFips];
          if (!mults) continue;

          const dem = Math.round(f.vd * mults.mD);
          const rep = Math.round(f.vr * mults.mR);
          const ots = Math.round(Math.max(0, f.vt - f.vd - f.vr) * mults.mO);
          const total = dem + rep + ots;

          let winnerId, maxVotes, secondVotes;

          if (numTp === 0) {
            if (dem >= rep) {
              winnerId = demCandId; maxVotes = dem; secondVotes = rep;
            } else {
              winnerId = repCandId; maxVotes = rep; secondVotes = dem;
            }
          } else {
            scratch[0].id = demCandId; scratch[0].votes = dem;
            scratch[1].id = repCandId; scratch[1].votes = rep;

            const tpShares = mults.tpShares;
            const defaultShare = 1 / numTp;
            for (let ti = 0; ti < numTp; ti++) {
              const candId = tpCandidatesInGame[ti];
              const share = (tpShares && tpShares[candId] !== undefined) ? tpShares[candId] : defaultShare;
              const row = scratch[2 + ti];
              row.id = candId;
              row.votes = Math.round(ots * share);
            }

            scratch.sort(byVotesDesc);

            winnerId = scratch[0].id;
            maxVotes = scratch[0].votes;
            secondVotes = scratch.length > 1 ? scratch[1].votes : 0;
          }

          // margin & color lookup
          const marginVal = total > 0 ? (maxVotes - secondVotes) / total : 0;
          const interpolator = colorInterpolators[winnerId];
          const color = interpolator ? interpolator(Math.sqrt(marginVal)) : "#888888";

          // only touch internals if the state changed
          const sig = winnerId + "_" + color;
          if (precColorCache[geoid] === sig) continue;
          precColorCache[geoid] = sig;

          _activeMlMap.setFeatureState(
            { source: "blockgroups", sourceLayer: "blockgroups", id: geoid },
            { color: color }
          );
        }
      });
    }

    // decade-level boundary-matched fallback helper
    function getFallbackVotesUrl(year, vintage) {
      const v = parseInt(vintage, 10);

      // modern decennial boundary mappings
      if (v >= 118) return getCdVotesUrl("2024", "119");
      if (v >= 113 && v <= 117) {
        const y = parseInt(year, 10);
        if (Math.abs(y - 2020) < Math.abs(y - 2016)) {
          return getCdVotesUrl("2020", "117");
        } else {
          return getCdVotesUrl("2016", "115");
        }
      }
      if (v >= 108 && v <= 112) return getCdVotesUrl("2008", "111");
      if (v >= 103 && v <= 107) return getCdVotesUrl("2008", "111");

      // for older/nonexistent historical cycles
      return "";
    }

    async function initDistrictLayer(vintage) {
      if (!_activeMlMap || !_activeMlMapReady) return;

      const v = vintage || document.getElementById("cd_vintage_selector")?.value || "2026";

      if (_cdCurrentVintage === v && _activeMlMap.getSource("districts-source")) {
        if (_activeMlMap.getLayer("cd-fill")) _activeMlMap.setLayoutProperty("cd-fill", "visibility", "visible");
        if (_activeMlMap.getLayer("cd-line")) _activeMlMap.setLayoutProperty("cd-line", "visibility", "visible");
        recolorDistricts(v, _districtCache.votes[v]);
        return;
      }

      invalidateDistrictCacheIfYearChanged();

      try {
        let geojson, votesTable = {};
        let exactVotesLoaded = false;

        const cachedTable = _districtCache.votes[v];
        const cachedGeo = _districtCache.geojson[v];
        if (cachedTable && cachedGeo) {
          geojson = cachedGeo;
          votesTable = cachedTable;
          exactVotesLoaded = true;
        }

        if (!exactVotesLoaded) try {
          const [geoRes, votesRes] = await Promise.all([
            fetch(getCdGeojsonUrl(v)),
            fetch(getCdVotesUrl(CURRENT_YEAR, v))
          ]);

          if (!geoRes.ok) throw new Error("GeoJSON 404");
          if (!votesRes.ok) throw new Error("Votes file 404");

          geojson = await geoRes.json();
          votesTable = await votesRes.json();
          exactVotesLoaded = true;
        } catch (firstErr) {
          // fetch boundary-matched decade fallback blueprint to retain non-homogeneous splits
          //console.warn(`Votes file 404 for ${CURRENT_YEAR} vintage ${v}. Retrying decade-level fallback...`);
          const fallbackUrl = getFallbackVotesUrl(CURRENT_YEAR, v);
          if (fallbackUrl) {
            try {
              const refMatch = fallbackUrl.match(/cd_votes_\d+_(\d+)\.json/);
              const refVintage = refMatch ? refMatch[1] : "0";

              // load the fallback directly if it is the EXACT same vintage
              // if they are different, we must run the dynamic generator instead
              if (String(v) === String(refVintage)) {
                [geojson, votesTable] = await Promise.all([
                  fetch(getCdGeojsonUrl(v)).then(r => r.json()),
                  fetch(fallbackUrl).then(r => {
                    if (!r.ok) throw new Error("Fallback votes file 404");
                    return r.json();
                  })
                ]);
                exactVotesLoaded = true;
                //console.log(`Loaded matching decennial fallback directly (no generator needed): ${fallbackUrl}`);
              }
            } catch (fallErr) {
              console.warn("Matching decennial fallback failed:", fallErr);
            }
          }

          if (!exactVotesLoaded) {
            // otherwise, load just the GeoJSON and run the generator with proxy
            try {
              geojson = await fetch(getCdGeojsonUrl(v)).then(r => r.json());
            } catch (geoErr) {
              console.error("Could not load GeoJSON for vintage:", v);
              return;
            }
          }
        }

        if (!geojson) return;

        // normalize and ensure cd_code is always populated on features
        geojson.features.forEach(f => {
          const cdCode = getFeatureCdCode(f);
          if (cdCode) {
            f.properties.cd_code = cdCode;
          }
        });

        // convert lat/long to screen space before calculating county weights
        const firstGeom = geojson.features[0]?.geometry;
        let isGeographic = false;
        let firstPt = null;
        if (firstGeom && firstGeom.coordinates) {
          if (firstGeom.type === "Polygon") firstPt = firstGeom.coordinates[0][0];
          else if (firstGeom.type === "MultiPolygon") firstPt = firstGeom.coordinates[0][0][0];
        }
        if (firstPt && Array.isArray(firstPt) && isFinite(firstPt[0]) && firstPt[0] < 0 && firstPt[0] >= -180) {
          isGeographic = true;
        }

        if (isGeographic) {
          projectGeoJsonToScreen(geojson);
        }

        _districtCache.geojson[v] = geojson;

        let finalVotesTable = votesTable;

        if (!exactVotesLoaded) {
          //console.log(`Generating dynamic spatial district weights from county shapes for ${CURRENT_YEAR} / vintage ${v}...`);

          const fallbackUrl = getFallbackVotesUrl(CURRENT_YEAR, v);
          let proxyTable = null;

          if (fallbackUrl) {
            try {
              proxyTable = await fetch(fallbackUrl).then(r => {
                if (!r.ok) throw new Error("Fallback votes file 404");
                return r.json();
              });
              //console.log(`Successfully loaded fallback blueprint from: ${fallbackUrl}`);
            } catch (fallbackErr) {
              console.warn("Could not load fallback blueprint:", fallbackErr);
            }
          }

          let refGeojsonData = null;
          if (proxyTable) {
            let refVintage = "111";
            const refMatch = fallbackUrl.match(/cd_votes_\d+_(\d+)\.json/);
            if (refMatch) refVintage = refMatch[1];

            try {
              if (_districtCache.geojson[refVintage]) {
                refGeojsonData = _districtCache.geojson[refVintage];
              } else {
                refGeojsonData = await fetch(getCdGeojsonUrl(refVintage)).then(r => r.json());
              }
            } catch (refGeoErr) {
              console.warn("Could not load reference GeoJSON for cross-walk:", refGeoErr);
            }
          }

          finalVotesTable = generateDistrictVotesTable(geojson, usCounties, fipsResults, proxyTable, refGeojsonData, proxyTable);
        }

        _districtCache.votes[v] = finalVotesTable;

        const src = _activeMlMap.getSource("districts-source");
        if (src) {
          src.setData(geojson);
        } else {
          _activeMlMap.addSource("districts-source", {
            type: "geojson",
            data: geojson,
            promoteId: "cd_code"
          });
        }

        if (!_activeMlMap.getLayer("cd-fill")) {
          const beforeId = _activeMlMap.getLayer("precinct-line") ? "precinct-line" : undefined;
          _activeMlMap.addLayer({
            id: "cd-fill",
            type: "fill",
            source: "districts-source",
            paint: {
              "fill-color": "#e5e5e8",
              "fill-opacity": 1
            }
          }, beforeId);
        } else {
          _activeMlMap.setLayoutProperty("cd-fill", "visibility", "visible");
        }

        if (!_activeMlMap.getLayer("cd-line")) {
          _activeMlMap.addLayer({
            id: "cd-line",
            type: "line",
            source: "districts-source",
            paint: {
              "line-color": "#ffffff",
              "line-width": 0.8
            }
          });
        } else {
          _activeMlMap.setLayoutProperty("cd-line", "visibility", "visible");
        }

        if (!_districtLayersAdded) {
          setupDistrictInteractions();
          _districtLayersAdded = true;
        }

        _cdCurrentVintage = v;
        invalidateDistrictFillMemo();
        recolorDistricts(v, finalVotesTable);

      } catch (err) {
        console.error("Error drawing districts:", err);
      }
    }

    function removeDistrictLayer() {
      if (!_activeMlMap) return;
      if (_activeMlMap.getLayer("cd-fill")) _activeMlMap.setLayoutProperty("cd-fill", "visibility", "none");
      if (_activeMlMap.getLayer("cd-line")) _activeMlMap.setLayoutProperty("cd-line", "visibility", "none");
    }

    function recolorDistricts(vintage, votesTable) {
      if (!_activeMlMap || !_activeMlMapReady || !_activeMlMap.getLayer("cd-fill")) return;

      const table = votesTable || {};
      const cdMargins = computeCdMargins(table, fipsResults, demCandId, repCandId, tpCandidatesInGame);
      _currentDistrictMargins = cdMargins;

      // if empty, set default color
      const keys = Object.keys(cdMargins);
      if (keys.length === 0) {
        _activeMlMap.setPaintProperty("cd-fill", "fill-color", "#e5e5e8");
        _lastCdFillExpr = "#e5e5e8";
        _lastCdFillSig = "__empty__";
        return;
      }

      const colorMatchExpression = ["match", ["get", "cd_code"]];
      const sigParts = [];

      for (const cdCode in cdMargins) {
        const m = cdMargins[cdCode];

        const candidateVotes = [
          { id: demCandId, votes: m.dem },
          { id: repCandId, votes: m.rep }
        ];
        if (m.tp) {
          for (const candId in m.tp) {
            candidateVotes.push({ id: candId, votes: m.tp[candId] });
          }
        }

        candidateVotes.sort(byVotesDesc);

        const winner = candidateVotes[0];
        const runnerUp = candidateVotes.length > 1 ? candidateVotes[1] : { votes: 0 };

        const totalVotes = m.dem + m.rep + (m.other || 0);
        const marginPct = totalVotes > 0 ? (winner.votes - runnerUp.votes) / totalVotes : 0;

        const interpolator = colorInterpolators[winner.id];
        const color = interpolator ? interpolator(Math.sqrt(marginPct)) : "#888888";
        colorMatchExpression.push(cdCode, color);
        sigParts.push(cdCode, color);
      }

      colorMatchExpression.push("#e5e5e8");

      const sig = sigParts.join("|");
      if (sig === _lastCdFillSig && _lastCdFillExpr) {
        return;
      }

      _activeMlMap.setPaintProperty("cd-fill", "fill-color", colorMatchExpression);
      _lastCdFillExpr = colorMatchExpression;
      _lastCdFillSig = sig;
    }

    function invalidateDistrictFillMemo() {
      _lastCdFillExpr = null;
      _lastCdFillSig = null;
    }

