            let cands = campaignTrail_temp.candidate_json;
            for (let i = 0; i < cands.length; i++) {
                if (cands[i].pk == pk) {
                    let f = cands[i].fields;
                    return POLL._candCache[pk] = { name: f.last_name, color: f.color_hex };
                }
            }
