                    ctx.lineCap = "round";

                    let hasStarted = false;
                    for (let i = 0; i < hLen; i++) {
                        let cData = history[i].data[pk];
                        if (!cData) continue;
                        let x = padL + i * stepX;
                        let y = padT + plotH - ((cData[mKey] - minY) / yRange) * plotH;

