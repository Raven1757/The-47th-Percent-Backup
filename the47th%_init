        });
      } else {
        // fall back to raw github json files
        const countyDataUrl = `https://raw.githubusercontent.com/StrawberryMaster/StrawberryMaster.github.io/refs/heads/master/scripts/county_results_${CURRENT_YEAR}.min.json`;
