    Object.values(candidateMaxPercentages).forEach(d => {
      if (d.counts > 0) {
        d.avg /= d.counts;
        d.percentiles.sort((a, b) => a - b);
        d.median = d.percentiles[Math.floor(d.percentiles.length / 2)];
        d.p10 = calculatePercentile(d.percentiles, 10);
