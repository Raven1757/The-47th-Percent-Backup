            let stepVal = mKey === 'pv'
                ? (range <= 10 ? 2 : (range <= 30 ? 5 : 10))
                : (range <= 20 ? 5 : (range <= 100 ? 25 : (range <= 300 ? 50 : 100)));

            minY = Math.floor(minY / stepVal) * stepVal;
            maxY = Math.ceil(maxY / stepVal) * stepVal;
            if (minY === maxY) maxY += stepVal;

