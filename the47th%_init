// deterministic PRNG (mulberry32)
function createRng(seed) {
  let a = seed >>> 0;
  return function () {
    a = (a + 0x6D2B79F5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), 1 | t);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// FNV-1a style string hash, used to derive a numeric seed from election identity
function hashString(str) {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h >>> 0;
}

// build a seeded random stream keyed on the election itself, so two different
// elections get different spatial patterns but the same one is always stable
function createElectionRng(electionId, year, candIds) {
  const key = `${electionId}|${year}|${[...candIds].sort().join(",")}`;
  return createRng(hashString(key));
}

// standard normal deviate (Box-Muller) from a supplied uniform generator
function randn(rand) {
  let u = 0, v = 0, s = 0;
  do {
    u = rand() * 2 - 1;
    v = rand() * 2 - 1;
    s = u * u + v * v;
  } while (s >= 1 || s === 0);
  return u * Math.sqrt(-2 * Math.log(s) / s);
}

// heavy tailed deviate
function randnHeavy(rand) {
  return randn(rand) / Math.sqrt(rand() * 0.18 + 0.82);
}

// clamp helper
function clampVal(x, lo, hi) {
  return x < lo ? lo : (x > hi ? hi : x);
}

// logit / inverse logit
function logit(p) {
  const q = clampVal(p, 1e-6, 1 - 1e-6);
  return Math.log(q / (1 - q));
}

function invLogit(x) {
  if (x > 0) {
    const e = Math.exp(-x);
    return 1 / (1 + e);
  }
  const e = Math.exp(x);
  return e / (1 + e);
}

